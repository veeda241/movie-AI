# Copy to .env and fill values. API loads this file on startup.

# Pexels API (Video Lab training downloads) — free key:
# https://www.pexels.com/api/
# Attribution required: link to Pexels + credit creators when possible.
PEXELS_API_KEY=

# Hugging Face token for LLM agents + remote video generation.
# Get a free token at https://huggingface.co/settings/tokens
# Without it, the multi-agent movie pipeline uses local planning (still works),
# but remote video generation is skipped (you'll get a "local fallback" warning video).
HF_TOKEN=

# Text LLM used by the 5 movie-planning agents (Director/Screenwriter/Cinematographer/
# Editor/VideoOrganizer). Any chat model on HF Inference works, e.g.:
#   meta-llama/Meta-Llama-3-8B-Instruct
#   Qwen/Qwen2.5-7B-Instruct
#   mistralai/Mistral-7B-Instruct-v0.3
HF_TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct

# Remote text-to-video model. Two flavors:
#   1) HF Inference (free, slow, cold-start ~30-60s):
#      HF_VIDEO_PROVIDER=hf-inference
#      HF_VIDEO_MODEL=ali-vilab/text-to-video-ms-1.7b      (≈2 GB, works on free tier)
#      HF_VIDEO_MODEL=tencent/HunyuanVideo                (large, may exceed free tier)
#   2) fal-ai (paid, fast): requires fal.ai account
#      HF_VIDEO_PROVIDER=fal-ai
#      HF_VIDEO_MODEL=Wan-AI/Wan2.2-T2V-A14B
# Note: UI model "wan-2.2" forces fal-ai + Wan2.2 regardless of these defaults.
HF_VIDEO_PROVIDER=hf-inference
HF_VIDEO_MODEL=ali-vilab/text-to-video-ms-1.7b
HF_VIDEO_REMOTE_FRAMES=16
HF_VIDEO_REMOTE_STEPS=20
HF_VIDEO_REMOTE_TIMEOUT=600

# Movie multi-agent video backend:
#   remote            — MotifClient / HF Inference / fal (default)
#   local-wan         — local Wan2.1-T2V-1.3B (needs CUDA + cached weights)
#   local-placeholder — force PIL/ffmpeg placeholder clips
# VIDEO_BACKEND=remote
# MOVIE_VIDEO_MODEL=wan-2.2

# Local Wan 2.1 1.3B (UI model wan-2.1-1.3b / VIDEO_BACKEND=local-wan):
# Prefetch: python scripts/download_wan.py --clear-no-exist
# WAN_STEPS=30
# WAN_FRAMES=81
# WAN_FPS=16
# WAN_HEIGHT=480
# WAN_WIDTH=832
# WAN_USE_LORA=false

# Set to "false" to *disable* the local PIL/ffmpeg "fake video" fallback when
# the remote call fails. With fallback disabled, missing HF_TOKEN / network
# errors / model-too-large errors surface as a job failure instead of a
# misleading gradient clip. Default: true (backwards compatible).
HF_ALLOW_LOCAL_FALLBACK=true

# Without HF_TOKEN the multi-agent movie pipeline uses local planning
# (deterministic scene outlines, no remote video). Movies still assemble.
GENERATE_KEYFRAMES=false

# Show a startup banner in the API log with HF_TOKEN / CUDA / model status.
# Useful to confirm your env is wired up correctly before spending credits.
API_DIAGNOSTICS=true

API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./storage/movie_flow.db
STORAGE_ROOT=./storage
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

CREDIT_COST_IMAGE=1
CREDIT_COST_VIDEO=5
CREDIT_COST_MOVIE_SCENE=8
CREDIT_COST_ASSEMBLE=1
STARTER_MONTHLY_CREDITS=500
PRO_MONTHLY_CREDITS=2000
FREE_SIGNUP_CREDITS=50

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_CREDITS_100=
STRIPE_PRICE_CREDITS_500=

MOVIE_FLOW_API_URL=http://127.0.0.1:8000
MOVIE_FLOW_API_TOKEN=
